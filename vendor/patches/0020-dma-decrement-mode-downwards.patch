The DMA controller's decrement mode transfers from the current address downwards, as the 8237: byte i at addr - pos
- i. Reads copied the bytes below the address and overwrote half of them instead of reversing them (the result
depended on the read's length: with 0017's shorter reads a decrement-mode sound played other bytes); writes stored
them forwards and scrambled the caller's buffer. T386_DMA_WRITE (0005) covers the bytes written. Sent upstream with
hchunhui/tiny386#61.

--- a/i8257.c
+++ b/i8257.c
@@ -414,16 +414,12 @@
 
     uint8_t *p = buf;
     if (r->mode & 0x20) {
-        for (hwaddr i = 0;
-             addr - pos - len + i < d->phys_mem_size && i < len;
-             i++) {
-            p[i] = d->phys_mem[addr - pos - len + i];
-        }
-        //cpu_physical_memory_read (d->phys_mem + addr - pos - len, buf, len);
-        /* What about 16bit transfers? */
-        for (int i = 0; i < len >> 1; i++) {
-            uint8_t b = p[len - i - 1];
-            p[i] = b;
+        /* decrement mode: the controller fetches from the current address
+           downwards, so byte i is at addr - pos - i */
+        for (int i = 0; i < len; i++) {
+            hwaddr a = addr - pos - i;
+            if (a < d->phys_mem_size)
+                p[i] = d->phys_mem[a];
         }
     } else {
         for (hwaddr i = 0;
@@ -450,19 +446,14 @@
 
