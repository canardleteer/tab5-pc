--- a/i8257.c
+++ b/i8257.c
@@ -445,6 +445,9 @@ int i8257_dma_write_memory(IsaDma *obj, int nchan, void *buf, int pos,
     }
 
     uint8_t *p = buf;
+#ifdef T386_DMA_WRITE   /* a code translator invalidates what it translated from there */
+    T386_DMA_WRITE((r->mode & 0x20) ? addr - pos - len + 1 : addr + pos, len);
+#endif
     if (r->mode & 0x20) {
         /* decrement mode: byte i goes to addr - pos - i (see the read) */
         for (int i = 0; i < len; i++) {
