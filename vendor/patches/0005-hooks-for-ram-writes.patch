

Rebased onto tiny386's decrement-mode DMA (its #61, which was our 0020): written downwards from the current
address, the bytes covered start at addr - pos - len + 1.

diff --git a/i386.c b/i386.c
index 958e9da..674080c 100644
--- a/i386.c
+++ b/i386.c
@@ -15,6 +15,12 @@
 #define noinline
 #endif
 
+/* called for writes to guest RAM: a code translator invalidates what it translated from there (no-op unless
+   defined) */
+#ifndef T386_RAM_WRITE
+#define T386_RAM_WRITE(cpu, addr, len) do {} while (0)
+#endif
+
 #define I386_OPT1
 #ifndef __wasm__
 #define I386_OPT2
@@ -816,6 +822,7 @@ static void IRAM_ATTR store8(CPUI386 *cpu, OptAddr *res, u8 val)
 	if (unlikely(addr >= cpu->phys_mem_size)) {
 		return;
 	}
+	T386_RAM_WRITE(cpu, addr, 1);
 	pstore8(cpu, addr, val);
 }
 
@@ -829,8 +836,11 @@ static void IRAM_ATTR store16(CPUI386 *cpu, OptAddr *res, u16 val)
 		return;
 	}
 	if (likely(res->res == ADDR_OK1)) {
+		T386_RAM_WRITE(cpu, res->addr1, 2);
 		pstore16(cpu, res->addr1, val);
 	} else {
+		T386_RAM_WRITE(cpu, res->addr1, 1);
+		T386_RAM_WRITE(cpu, res->addr2, 1);
 		pstore8(cpu, res->addr1, val);
 		pstore8(cpu, res->addr2, val >> 8);
 	}
@@ -846,8 +856,11 @@ static void IRAM_ATTR store32(CPUI386 *cpu, OptAddr *res, u32 val)
 		return;
 	}
 	if (likely(res->res == ADDR_OK1)) {
+		T386_RAM_WRITE(cpu, res->addr1, 4);
 		pstore32(cpu, res->addr1, val);
 	} else {
+		T386_RAM_WRITE(cpu, res->addr1 & ~3, 4);
+		T386_RAM_WRITE(cpu, res->addr2, 4);
 		switch(res->addr1 & 0xf) {
 		case 0xf:
 			pstore8(cpu, res->addr1, val);
@@ -2895,6 +2908,7 @@ static bool call_isr(CPUI386 *cpu, int no, bool pusherr, int ext);
 		if (cpu->cb.io_read_string && dir > 0 && \
 		    (memld.addr1 | 4095) < cpu->phys_mem_size && \
 		    !in_iomem(memld.addr1) && !in_iomem(memld.addr1 | 4095)) { \
+			T386_RAM_WRITE(cpu, memld.addr1, count * (BIT / 8)); \
 			int count1 = cpu->cb.io_read_string( \
 				cpu->cb.io, lreg16(2), \
 				cpu->phys_mem + memld.addr1, dir, count); \
diff --git a/i8257.c b/i8257.c
