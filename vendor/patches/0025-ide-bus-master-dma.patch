+/* ---- PIIX bus-master DMA ----
+   A READ DMA / WRITE DMA command waits until the bus master is started (or runs at once if it was),
+   then moves its sectors between the image and guest RAM by the PRD table (address, byte count, bit
+   31: the last), up to WRITE_GATHER_SECTORS at a time through the drive's buffer, and interrupts once. */
+#ifndef T386_DMA_WRITE   /* a code translator invalidates what it translated from guest RAM written */
+#define T386_DMA_WRITE(addr, len) do {} while (0)
+#endif
+#define BM_CMD_START 0x01
+#define BM_ST_ACTIVE 0x01
+#define BM_ST_ERROR 0x02
+#define BM_ST_IRQ 0x04
+
+uint32_t ide_bm_base = 0x10000; /* BAR4's ports (none until mapped: above any port) */
+static IDEIFState *ide_bm_if[2];
+static uint8_t *ide_dma_mem;
+static uint32_t ide_dma_mem_size;
+
+/* guest RAM, not the 640K-1M hole (video memory, ROMs, the device state) */
+static int ide_dma_mem_ok(uint32_t addr, uint32_t len)
+{
+    if (addr >= ide_dma_mem_size || len > ide_dma_mem_size - addr)
+        return 0;
+    return addr >= 0x100000 || addr + len <= 0xa0000;
+}
+
+static uint32_t ide_dma_ld32(uint32_t addr)
+{
+    uint32_t v;
+    memcpy(&v, ide_dma_mem + addr, 4);
+    return v;
+}
+
+static void ide_dma_run(IDEState *s)
+{
+    IDEIFState *ifs = s->ide_if;
+    const int to_mem = s->dma_cmd == 1;
+    int n = s->nsector ? s->nsector : 256, err = 0, eot = 0;
+    int64_t sector = ide_get_sector(s);
+    uint32_t prd = ifs->bm_prd, addr = 0, left = 0; /* the PRD entry being used: where, how much left */
+
+    s->dma_cmd = 0;
+    ifs->dma_drive = NULL;
+    if (!s->wbuf)
+        s->wbuf = ide_buf_alloc();
+    if (!s->wbuf || !ide_dma_mem)
+        err = 1;
+    while (n > 0 && !err) {
+        const int k = n < WRITE_GATHER_SECTORS ? n : WRITE_GATHER_SECTORS;
+        const uint32_t bytes = k * 512;
+        if (to_mem && s->bs->read_async(s->bs, sector, s->wbuf, k, NULL, NULL) != 0) {
+            err = 1;
+            break;
+        }
+        for (uint32_t off = 0; off < bytes;) {
+            if (!left) {
+                uint32_t c;
+                if (eot || !ide_dma_mem_ok(prd, 8)) {
+                    err = 1;
+                    break;
+                }
+                addr = ide_dma_ld32(prd);
+                c = ide_dma_ld32(prd + 4);
+                left = c & 0xfffe;
+                if (!left)
+                    left = 0x10000;
+                eot = c >> 31;
+                prd += 8;
+                if (!ide_dma_mem_ok(addr, left)) {
+                    err = 1;
+                    break;
+                }
+            }
+            const uint32_t m = bytes - off < left ? bytes - off : left;
+            if (to_mem) {
+                memcpy(ide_dma_mem + addr, s->wbuf + off, m);
+                T386_DMA_WRITE(addr, m);
+            } else {
+                memcpy(s->wbuf + off, ide_dma_mem + addr, m);
+            }
+            addr += m;
+            left -= m;
+            off += m;
+        }
+        if (!err && !to_mem && s->bs->write_async(s->bs, sector, s->wbuf, k, NULL, NULL) != 0)
+            err = 1;
+        if (err)
+            break;
+        sector += k;
+        n -= k;
+    }
+    if (err) {
+        ide_abort_command(s);
+        ifs->bm_status |= BM_ST_ERROR;
+    } else {
+        ide_set_sector(s, sector);
+        s->nsector = 0;
+        s->status = READY_STAT | SEEK_STAT;
+        s->error = 0;
+    }
+    ifs->bm_status = (ifs->bm_status & ~BM_ST_ACTIVE) | BM_ST_IRQ;
+    ide_set_irq(s);
+}
+
+static void ide_dma_start(IDEState *s, int to_mem)
+{
+    IDEIFState *ifs = s->ide_if;
+    if (!ide_dma_mem) {
+        ide_abort_command(s);
+        ide_set_irq(s);
+        return;
+    }
+    s->dma_cmd = to_mem ? 1 : 2;
+    ifs->dma_drive = s;
+    s->status = READY_STAT | SEEK_STAT | DRQ_STAT;
+    s->error = 0;
+    if (ifs->bm_cmd & BM_CMD_START)
+        ide_dma_run(s);
+}
+
+static void ide_bm_write8(IDEIFState *ifs, int reg, uint8_t v)
+{
+    switch (reg) {
+    case 0: {
+        const uint8_t old = ifs->bm_cmd;
+        ifs->bm_cmd = v & 0x09;
+        if (!(v & BM_CMD_START)) {
+            ifs->bm_status &= ~BM_ST_ACTIVE;
+        } else if (!(old & BM_CMD_START)) {
+            ifs->bm_status |= BM_ST_ACTIVE;
+            if (ifs->dma_drive && ifs->dma_drive->dma_cmd)
+                ide_dma_run(ifs->dma_drive);
+        }
+        break;
+    }
+    case 2: /* bits 1, 2 written 1: cleared; 5, 6: as written */
+        ifs->bm_status = (ifs->bm_status & ~(v & 0x06) & ~0x60) | (v & 0x60);
+        break;
+    case 4: case 5: case 6: case 7: {
+        const int sh = (reg - 4) * 8;
+        ifs->bm_prd = ((ifs->bm_prd & ~(0xffu << sh)) | ((uint32_t)v << sh)) & ~3u;
+        break;
+    }
+    }
+}
+
+static uint8_t ide_bm_read8(IDEIFState *ifs, int reg)
+{
+    switch (reg) {
+    case 0: return ifs->bm_cmd;
+    case 2: return ifs->bm_status;
+    case 4: case 5: case 6: case 7: return ifs->bm_prd >> ((reg - 4) * 8);
+    }
+    return 0;
+}
+
+/* BAR4's ports (offset from ide_bm_base: 0-7 the first channel's, 8-15 the second's), 1 << size_log2 bytes */
+uint32_t ide_bm_read(uint32_t off, int size_log2)
+{
+    IDEIFState *ifs = ide_bm_if[(off >> 3) & 1];
+    uint32_t v = 0;
+    for (int i = 0; i < (1 << size_log2); i++)
+        v |= (uint32_t)(ifs ? ide_bm_read8(ifs, (off + i) & 7) : 0xff) << (8 * i);
+    return v;
+}
+
+void ide_bm_write(uint32_t off, uint32_t val, int size_log2)
+{
+    IDEIFState *ifs = ide_bm_if[(off >> 3) & 1];
+    if (!ifs)
+        return;
+    for (int i = 0; i < (1 << size_log2); i++)
+        ide_bm_write8(ifs, (off + i) & 7, val >> (8 * i));
+}
