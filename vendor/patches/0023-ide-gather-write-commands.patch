+               before this one had moved them on) */
+            ide_set_sector(s, s->wsector);
+            s->nsector = (s->nsector + n - s->io_nb_sectors) & 0xff;
+        }
         ide_abort_command(s);
         ide_set_irq(s);
     } else if (ret == 0) {
