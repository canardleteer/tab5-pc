A PC reset (a reboot, the RESET key) resets the keyboard controller, the keyboard and the mouse too,
as a board's reset line and its BIOS do. They kept their state: a mouse still reporting from the
system before filled its queue while the next one started, and Linux, finding more than 16 bytes
waiting, took the controller for absent ("i8042: No controller found"): no keyboard, no mouse.

--- a/i8042.c
+++ b/i8042.c
@@ -935,3 +935,58 @@ PS2MouseState *ps2_mouse_init(void (*update_irq)(void *, int), void *update_arg)
     ps2_reset(&s->common);
     return s;
 }
+
+static void ps2_queue_clear(PS2State *s)
+{
+    PS2Queue *q = &s->queue;
+#ifdef THREAD_SAFE
+    xSemaphoreTake(q->mutex, portMAX_DELAY);
+#endif
+    q->rptr = 0;
+    q->wptr = 0;
+    q->count = 0;
+    s->write_cmd = -1;
+#ifdef THREAD_SAFE
+    xSemaphoreGive(q->mutex);
+#endif
+}
+
+/* The PC's reset: the controller, keyboard and mouse as at power on, as a
+   board's reset line and its BIOS leave them. Kept as they were, a mouse
+   still reporting from before the reset filled its queue while the next
+   system started, and Linux, finding more than 16 bytes waiting, took the
+   controller for absent: no keyboard, no mouse. */
+void i8042_reset(KBDState *s)
+{
+    PS2KbdState *k = s->kbd;
+    PS2MouseState *m = s->mouse;
+
+#ifdef THREAD_SAFE
+    while (atomic_flag_test_and_set_explicit(&(k->delay_flag),
+                                             memory_order_acquire)) {}
+#endif
+    k->delay = false;
+    ps2_queue_clear(&k->common);
+#ifdef THREAD_SAFE
+    atomic_flag_clear_explicit(&(k->delay_flag), memory_order_release);
+#endif
+    k->scan_enabled = 0;
+    k->translate = 0;
+
+    ps2_queue_clear(&m->common);
+    m->mouse_status = 0;
+    m->mouse_resolution = 0;
+    m->mouse_sample_rate = 0;
+    m->mouse_wrap = 0;
+    m->mouse_type = 0;
+    m->mouse_detect_state = 0;
+    m->mouse_dx = 0;
+    m->mouse_dy = 0;
+    m->mouse_dz = 0;
+    m->mouse_buttons = 0;
+
+    kbd_reset(s);
+    s->write_cmd = 0;
+    s->pending = 0;
+    kbd_update_irq(s);
+}
--- a/i8042.h
+++ b/i8042.h
@@ -17,6 +17,7 @@ void ps2_mouse_event(PS2MouseState *s,
                      int dx, int dy, int dz, int buttons_state);
 
 typedef struct KBDState KBDState;
+void i8042_reset(KBDState *s);
 
 uint32_t kbd_read_status(void *opaque, uint32_t addr);
 void kbd_write_command(void *opaque, uint32_t addr, uint32_t val);
--- a/pc.c
+++ b/pc.c
@@ -599,6 +599,7 @@
 {
 	if (pc->reset_request) {
 		pc->reset_request = 0;
+		i8042_reset(pc->i8042);
 		load_bios_and_reset(pc);
 	}
 
